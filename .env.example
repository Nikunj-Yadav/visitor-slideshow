# Copy to .env and change the values. Never commit the real .env file.
PORT=3000
# Required. Password for the admin dashboard.
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Required. Long random string used to sign the admin cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=replace-with-64-random-hex-characters
# Where the database and uploaded photos are stored.
DATA_DIR=./data
# Upload limits
MAX_FILE_MB=8
MAX_FILES_PER_REQUEST=10
MAX_PHOTOS_PER_VISITOR=30
# Set to true when served over HTTPS (adds the Secure flag to the admin cookie).
COOKIE_SECURE=false
